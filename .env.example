# Server
PORT=3001
NODE_ENV=development

# Neon PostgreSQL connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Clerk (Backend API)
# Secret stays in backend/.env only — never commit sk_ keys
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_aW50ZW50LXNxdWlkLTQ5MTYuY2xlcmsuYWNjb3VudHMuZGV2JA

# CORS — use * for public API (any front-end / CRM / mobile WebView)
# Or restrict: https://your-game.vercel.app,https://your-crm.vercel.app
CORS_ORIGINS=*

# Training time multiplier (1 = live lengths: drill ~2m, session ~3m, intensive ~6m)
# TRAINING_TIME_SCALE=1
# Legacy: TRAINING_DURATION_SECONDS=60 scales times as 60/180 of live
# TRAINING_DURATION_SECONDS=60
